# IBM watsonx.ai Credentials
# Obtain from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_watsonx_api_key_here

# Your IBM watsonx.ai Project ID
# Find in: watsonx.ai > Projects > Your Project > Manage > General
WATSONX_PROJECT_ID=your_project_id_here

# IBM watsonx.ai regional endpoint
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Flask secret key (generate a strong random string)
FLASK_SECRET_KEY=change_this_to_a_strong_random_secret_key

# Optional: Set to "true" to enable demo mode without a real API key
DEMO_MODE=false
